# Dependencies — reinstalled via npm ci inside the image.
node_modules
api/node_modules

# Build outputs — regenerated by npm run build inside the image.
dist
api/dist
coverage

# VCS + tooling.
.git
.gitignore
.github

# Local env / secrets — must never enter the image.
.env
.env.*
!.env.example

# Editor / OS cruft.
.vscode
.idea
.DS_Store
*.log

# Nix / packaging artifacts not needed for the web/api builds.
flake.nix
flake.lock
*.s9pk
.umbrel-digests
