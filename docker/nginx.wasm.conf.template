# WASM mode: static SPA only. The wallet runs in the browser and talks to the
# ark server + esplora directly — no /api proxies here.
server {
  listen ${PORT};
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # The bundle's own CSP travels in a <meta> tag, but `frame-ancestors` is
  # ignored there by spec, so clickjacking protection has to come from a real
  # response header. The wallet holds its seed in browser memory, so framing it
  # must be denied outright rather than left to the ignored meta directive.
  add_header Content-Security-Policy "frame-ancestors 'none'" always;
  add_header X-Frame-Options "DENY" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "no-referrer" always;

  # Avoid caching index.html so deploys go live immediately.
  # `add_header` does not inherit into a location that sets its own headers, so
  # the security headers above are repeated here and in /assets/.
  location = /index.html {
    add_header Content-Security-Policy "frame-ancestors 'none'" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Cache-Control "no-store, no-cache, must-revalidate" always;
    try_files $uri =404;
  }

  # Hashed static assets — cache long-term. No "always" flag: a 404 for a
  # stale chunk must stay uncacheable so a reload can recover after deploys.
  location /assets/ {
    add_header Content-Security-Policy "frame-ancestors 'none'" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }

  # SPA fallback.
  location / {
    try_files $uri $uri/ /index.html;
  }
}
