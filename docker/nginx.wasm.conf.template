# WASM mode: static SPA only. The wallet runs in the browser and talks to the
# ark server + esplora directly — no /api or /barkd-ws proxies here.
server {
  listen ${PORT};
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # Avoid caching index.html so deploys go live immediately.
  location = /index.html {
    add_header Cache-Control "no-store, no-cache, must-revalidate" always;
    try_files $uri =404;
  }

  # Hashed static assets — cache long-term. No "always" flag: a 404 for a
  # stale chunk must stay uncacheable so a reload can recover after deploys.
  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }

  # SPA fallback.
  location / {
    try_files $uri $uri/ /index.html;
  }
}
