# Pinned SHA-256 checksums for the barkd release binaries pulled from
# https://gitlab.com/ark-bitcoin/bark/-/releases/bark-${BARK_VERSION}/downloads/
#
# Refresh per BARK_VERSION bump. Compute via:
#   curl -fsSL <url> | sha256sum
#
# Leaving a value empty makes the build skip verification with a warning —
# acceptable for local dev, NOT for images you publish to Docker Hub.

BARK_VERSION=0.2.0
BARKD_SHA256_AMD64=2b81ba5aa346caa32e0bf747f7ead215139641d8dc6ce0d3d6e2be57530be0cf
BARKD_SHA256_ARM64=acfbdfa3f5b0a5a50ecd97e6541bdafc89c21b0fa986ca3302a6d126f70cfc71
