# Bring-your-own-barkd dev flow.
# Copy this file to .env.byob and fill in your running barkd's details.
# Then run: npm run dev:byob
#
# This flow runs ONLY the vite app — no docker, no bark-web-api (Hono).
# The vite dev server serves /api/config from these vars and proxies
# /api/barkd to your barkd, injecting the bearer token server-side.

# Your running barkd's HTTP base URL.
BARKD_URL=http://localhost:3000

# barkd bearer token. Read server-side by the vite proxy only — it is NOT
# bundled into the browser (do not add a VITE_ prefix to this var).
BARKD_AUTH_TOKEN=

# Network (signet | mainnet | mutinynet | regtest)
BARK_NETWORK=signet

# Ark server for your network.
ARK_SERVER=https://ark.signet.2nd.dev

# Chain source. Set EITHER an esplora URL, or a bitcoind RPC address with a
# cookie file path. If both are set, bitcoind wins and a warning is logged.
# Only applies when a wallet is created — existing wallets keep the source
# recorded in barkd's datadir.
CHAIN_SOURCE=https://esplora.signet.2nd.dev

# The cookie path is opened by your barkd process, not by the browser or the
# vite dev server. Only the path is sent to the browser, never its contents.
BITCOIND_RPC_URL=
BITCOIND_RPC_COOKIE_FILE=
