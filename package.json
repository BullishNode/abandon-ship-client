    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "oxfmt": "^0.45.0",
    "oxlint": "^1.60.0",
    "oxlint-tsgolint": "^0.22.1",
    "typescript": "~5.9.3",
    "ultracite": "^7.5.9",
    "vite": "^8.0.12",
    "vitest": "^4.1.5"
  },
