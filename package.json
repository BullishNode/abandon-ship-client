{
  "name": "bark-web",
  "version": "0.1.0",
  "private": true,
  "description": "A web-based graphical user interface for managing bark wallets",
  "keywords": [
    "Ark",
    "Bark",
    "Bitcoin"
  ],
  "bugs": {
    "url": "https://gitlab.com/ark-bitcoin/labs/bark-web/-/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Second",
    "url": "https://second.tech/"
  },
  "type": "module",
  "scripts": {
    "dev": "docker compose --env-file .env.local up --build",
    "dev:bark-web": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "check": "ultracite check --type-aware --type-check",
    "fix": "ultracite fix --type-aware --type-check"
  },
  "dependencies": {
    "@base-ui/react": "^1.0.0",
