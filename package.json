{
  "name": "bark-web",
  "version": "0.6.0",
  "private": true,
  "description": "A web-based graphical user interface for managing bark wallets",
  "keywords": [
    "Ark",
    "Bark",
    "Bitcoin"
  ],
  "bugs": {
    "url": "https://gitlab.com/ark-bitcoin/labs/bark-web/-/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Second",
    "url": "https://second.tech/"
  },
  "workspaces": [
    "api"
  ],
  "type": "module",
  "scripts": {
    "dev": "node scripts/compose.mjs --env-file .env.local up --build",
    "dev:signet": "node scripts/compose.mjs --env-file .env.signet up --build",
    "dev:signet:auth": "node scripts/auth-dev-setup.mjs && node scripts/compose.mjs -f docker-compose.yml -f docker-compose.auth.yml --env-file .env.signet up --build",
    "dev:mainnet": "node scripts/compose.mjs --env-file .env.mainnet up --build",
    "dev:mainnet:auth": "node scripts/auth-dev-setup.mjs && node scripts/compose.mjs -f docker-compose.yml -f docker-compose.auth.yml --env-file .env.mainnet up --build",
    "down": "node scripts/compose.mjs --env-file .env.local down",
    "down:signet": "node scripts/compose.mjs --env-file .env.signet down",
    "down:mainnet": "node scripts/compose.mjs --env-file .env.mainnet down",
    "dev:byob": "vite --mode byob",
    "dev:wasm": "vite --mode wasm",
    "build:wasm": "tsc -b && vite build --mode wasm",
    "dev:web": "vite",
    "dev:api": "npm --workspace api run dev",
    "build": "tsc -b && vite build",
    "gen:favicon": "node scripts/gen-favicon.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -b",
    "check": "ultracite check --type-aware --type-check",
    "fix": "ultracite fix --type-aware --type-check",
    "images:build": "bash scripts/podman-build.sh",
    "images:push": "bash scripts/podman-build.sh --push",
    "umbrel:build": "bash scripts/umbrel-build.sh",
    "umbrel:digests": "bash scripts/umbrel-digests.sh",
    "umbrel:sync-compose": "bash scripts/umbrel-sync-compose.sh",
    "umbrel:ship": "npm run umbrel:build && npm run umbrel:digests && npm run umbrel:sync-compose",
    "start9:build": "bash scripts/start9-build.sh"
  },
  "dependencies": {
    "@branta-ops/branta": "^3.1.4",
    "@chenglou/pretext": "^0.0.6",
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@fontsource-variable/source-code-pro": "^5.2.7",
    "@hookform/resolvers": "^5.2.2",
    "@noble/ciphers": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@phosphor-icons/react": "^2.1.10",
    "@scure/bip39": "^2.0.1",
    "@secondts/bark": "^0.16.1",
    "@secondts/barkd": "^0.6.1",
    "@stepperize/react": "^5.1.9",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-query": "^5.90.16",
    "@tanstack/react-table": "^8.21.3",
    "@yudiel/react-qr-scanner": "^2.5.1",
    "bip-321": "^0.0.11",
    "bitcoin-decoder": "^0.6.2",
    "bitcoinjs-lib": "^7.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "comlink": "^4.4.2",
    "i18next": "^26.1.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "motion": "^12.26.2",
    "partysocket": "^1.1.18",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.71.0",
    "react-i18next": "^17.0.7",
    "react-qrcode-logo": "^4.0.0",
    "react-router-dom": "^7.11.0",
    "recharts": "^3.8.0",
    "shadcn": "^3.6.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.3.5",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@rolldown/plugin-babel": "^0.2.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^25.0.1",
    "msw": "^2.14.6",
    "oxfmt": "^0.45.0",
    "oxlint": "^1.60.0",
    "oxlint-tsgolint": "^0.22.1",
    "sharp": "^0.35.1",
    "typescript": "~5.9.3",
    "ultracite": "^7.5.9",
    "vite": "^8.0.12",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "react-is": "^19.2.0"
  },
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "npm@10.9.2"
}
