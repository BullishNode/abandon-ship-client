# Copy this file to .env.local and adjust per your dev needs.
# For ready-made profiles use .env.signet or .env.mainnet.

# Network (signet | mainnet | mutinynet | regtest)
BARK_NETWORK=signet

# Ark server + chain source per network
ARK_SERVER=https://ark.signet.2nd.dev
CHAIN_SOURCE=https://esplora.signet.2nd.dev

# Pinned barkd release + checksums per arch (see docker/checksums.env)
BARK_VERSION=0.2.2
BARKD_SHA256_AMD64=
BARKD_SHA256_ARM64=

# Compose project namespace — keeps wallet volumes separate per network.
COMPOSE_PROJECT_NAME=bark-signet

# Self-deploy CORS allowlist for the api process. Comma-separated origins.
# Leave empty to deny all cross-origin requests (recommended when the api is
# fronted by a reverse proxy that serves the web UI from the same origin —
# Umbrel and Start9 builds work fine with no allowlist). Only set this if you
# run the api on a separate origin from your web UI.
# Example: ALLOWED_ORIGINS=https://wallet.example.com,https://other.example.com
ALLOWED_ORIGINS=
